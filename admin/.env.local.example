# Copy to .env.local and fill in. Never commit .env.local.

# Browser-side (anon key) — used by the login form and any client component.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-side (service role key) — bypasses RLS for admin reads.
# Keep this off the client. Vercel: set it as a non-public env var.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Upstash Redis — cross-instance counters + edge rate limits.
# Free tier at https://console.upstash.com. Pick the region nearest the
# Supabase project (eu-central-1 / Frankfurt) — every limited request pays a
# round trip here.
#
# Locally, empty means the limiter no-ops. IN PRODUCTION IT FAILS CLOSED:
# login and audit export refuse outright (lib/redis.ts). A production deploy
# without these is not a console with weaker rate limiting, it is a console
# nobody can sign in to.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security hardening (proxy.ts).
#
# Shared secret proving a request came through Cloudflare rather than straight
# at the *.vercel.app origin, where Access, the WAF and the IP allowlist are
# all absent. Cloudflare sets the matching header with a Transform Rule; see
# DEPLOY.md. Origin hostnames are not secret — they show up in certificate
# transparency logs — so this is what stops the front door being walked around.
# Empty = unenforced (local dev, and the first deploy before the rule exists).
ADMIN_ORIGIN_SECRET=
# IP allowlist — comma-separated exact IPs and/or IPv4 CIDR blocks. Read from
# CF-Connecting-IP, which Cloudflare overwrites and a caller cannot forge —
# but only while ADMIN_ORIGIN_SECRET is set, since a request that reaches the
# origin directly can claim any IP it likes. Set both or neither. When empty,
# the allowlist is DISABLED (allow all) — set it in production to pin the
# console to office / VPN egress IPs. Applies to every route incl. /login.
ADMIN_IP_ALLOWLIST=
# Require every admin to enrol TOTP 2FA (not just those who already have it).
# "true" forces enrolment on next sign-in; anything else = enforce 2FA only for
# admins who have already set up a factor.
ADMIN_REQUIRE_MFA=false

# Absolute HTTPS origin allowed in Supabase Auth redirect settings. The custom
# invite template appends /auth/confirm. Local development may use localhost.
ADMIN_INVITE_REDIRECT_URL=https://admin.venttly.com

# Independent, server-only UI pilots. Off until reviewed and verified.
# Shell cohort defaults to super_admin. Never use NEXT_PUBLIC for these flags.
ADMIN_SHELL_V2=false
ADMIN_SHELL_V2_ROLES=super_admin
# Also requires the shell cohort above; snapshots need reviewed local/staging
# migration and worker warm-up. See docs/overview-batch-1.md.
ADMIN_OVERVIEW_V2=false
# Shared queue KPIs/badges also require the audited inbox backend rollout.
# Independent of ADMIN_INBOX_UI. See docs/attention-batch-2.md.
ADMIN_ATTENTION_UI=false
# Daily workflow renovation within the modern-shell cohort. Requires Batch 3 DDL.
ADMIN_WORKFLOWS_UI=false
# Inbox also requires its independent audited database rollout.
ADMIN_INBOX_UI=false
# Notification failure review/retry UI only; never enables the database worker.
ADMIN_INBOX_RECOVERY_UI=false
# Incident lifecycle remains independently disabled until local/staging gates pass.
ADMIN_INCIDENTS_UI=false
# Canonical staff reviews: requires promoted/verified pending access-review SQL
# plus a separate audited database enable. Keep off until live gates pass.
ADMIN_ACCESS_REVIEWS_UI=false
# Canonical invitation tracking: requires promoted/verified pending SQL and its
# audited DB enable. Dedicated random 32-byte key encoded as 64 hex characters;
# stable across instances. Never rotate without a reviewed ledger re-key plan.
ADMIN_INVITATION_LEDGER_UI=false
# Separate setup-repair pilot; also requires its independent database switch.
ADMIN_INVITATION_SETUP_REPAIR_UI=false
ADMIN_GOVERNANCE_NOTICES_UI=false
# Appearance pilot. Rebuild/restart for enablement or rollback; no backend writes.
# Keep off until real-browser and all-route accessibility checks pass.
ADMIN_THEME_UI=false
ADMIN_INVITATION_HMAC_KEY=
# Independent emergency write pause, including the legacy invitation path.
# Set true on every instance BEFORE rolling back the tracking UI/implementation.
ADMIN_STAFF_INVITES_DISABLED=false
# UI only. Database enforcement is separately service-controlled; turning this
# off must NOT restore single-operator promotions. Pending SQL is not applied.
ADMIN_PROMOTION_APPROVALS_UI=false
ADMIN_BROADCAST_APPROVALS_UI=false
ADMIN_CATALOG_WORKSPACES_UI=false
# Stream shared operational aggregates independently of authorized page chrome.
ADMIN_CONTROL_WORKSPACES_UI=false
