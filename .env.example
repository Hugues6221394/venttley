# Copy values into your shell or pass them as --dart-define=NAME=value.
# The app still defaults to the production Supabase project in
# lib/core/constants.dart when these are unset.

# --- Flutter / dart-define -------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
USE_MOCK_BACKEND=false
TENOR_API_KEY=
OAUTH_REDIRECT_URL=
SOCIAL_AUTH_ENABLED=true
STRIPE_PUBLISHABLE_KEY=
FCM_ENABLED=false
OTEL_ENDPOINT=
OTEL_HEADERS=
RESEND_FROM_ADDRESS=hello@venttly.app
RESEND_ENABLED=false
SENTRY_DSN=
VENTTLY_ENV=dev
SENTRY_TRACES=0.1
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API=
POSTHOG_KEY=
POSTHOG_HOST=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# --- media-scan (Supabase function secrets) --------------------------
# Local NudeNet sidecar: docker compose -f services/nsfw-classifier/docker-compose.yml up
# Functions running on the host use 127.0.0.1; functions in Docker use host.docker.internal.
NSFW_CLASSIFIER_URL=http://127.0.0.1:8090
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
SIGHTENGINE_MODELS=nudity-2.1,gore
SIGHTENGINE_CSAM=off
MEDIA_SCAN_ENABLED=true

# Cloudflare Turnstile (CAPTCHA on sign-in and sign-up).
#
# The SITE key is a public identifier and is safe in the app binary — it is
# compiled in as a default. The SECRET key is Cloudflare's half and belongs in
# Supabase (Authentication > Attack Protection), never here and never shipped.
#
# TURNSTILE_ENABLED gates the client independently of the key, so tokens can be
# shipped and observed before enforcement is switched on in Supabase. Turn the
# client on first: enabling enforcement while the app sends no token refuses
# every sign-in.
#   flutter run --dart-define=TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_ENABLED=false
