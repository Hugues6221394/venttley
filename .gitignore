# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android production signing material must never enter source control.
# The upload keystore and anything else that must never leave this machine.
# *.jks and *.keystore below already cover the key itself; this covers the
# directory the signing config points at, so a stray export cannot be added
# by a wildcard `git add`.
/private/
/android/key.properties
*.jks
*.keystore

# Claude Code local state (transient locks, session data)
.claude/

# Golden-test failure output. Rewritten on every failing run, so tracked
# copies are permanently dirty; read them locally, don't commit them.
/test/failures/

# Originals saved by tool/scrub_uploaded_image_metadata.dart before it
# overwrites them. These are real user photos WITH their original EXIF —
# they must never be committed.
exif-backfill-backup/

# Node dependencies for the load-test harness. Reinstall with `npm ci` in
# loadtest/ — package-lock.json is committed, the 8.9MB tree is not.
node_modules/

# Database dumps. These contain real member content — posts, DMs, auth rows.
# A production backup briefly sat in this directory untracked and one `git add
# -A` from being published. Never again by accident.
venttly-prod-backup-*/
*-prod-backup-*/
*.dump
supabase/**/prodbackup/

# The designer's drop folder. The twenty-five layer files the avatar build
# script reads are committed by name; the rest of what lands here is phone
# screenshots and flattened sheets — 56MB of reference that nothing reads and
# that Flutter does not bundle (asset globs do not recurse into it).
assets/images/avatars/avatarsfiles/*
!assets/images/avatars/avatarsfiles/Asset Layer*.png
!assets/images/avatars/avatarsfiles/Asset2*.png
!assets/images/avatars/avatarsfiles/Asset3*.png
coverage/
